# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sesodigital

# Firebase Admin SDK — from Firebase Console -> Project Settings -> Service Accounts
# -> Generate new private key. Save the downloaded JSON file in this folder as
# firebase-service-account.json (already gitignored) and leave this path as-is,
# or point it elsewhere.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Firebase Storage bucket name (Firebase Console -> Storage), e.g. sesodigital-app.appspot.com
FIREBASE_STORAGE_BUCKET=

# OAuth Web Client ID from Google Cloud Console — used to verify ID tokens sent by
# the Android app (same value as GoogleAuthConfig.WEB_CLIENT_ID in the Android project).
GOOGLE_WEB_CLIENT_ID=793820439151-l72frjgorlnmuhvc4k4g9e75pr54ag81.apps.googleusercontent.com
